# Шаблон: cp terraform.tfvars.example terraform.tfvars і підставте свої значення
aws_region       = "us-east-1"
ami_id           = ""                       # "" = найновіший Ubuntu 24.04 LTS, або "ami-..."
instance_type    = "t3.micro"
key_name         = "my-key-pair"            # назва Key Pair в EC2
public_key_path  = null                     # або "~/.ssh/id_ed25519.pub", щоб Terraform створив Key Pair
private_key_path = "~/.ssh/id_rsa"          # шлях до приватного ключа (.pem)
app_port         = 3000
